<?xml version="1.0"?>
<sdf version="1.9">
 <world name="argos_shared_yard">
  <physics name="1ms" type="ignore"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
  <gravity>0 0 -9.8</gravity>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"><engine><filename>gz-physics-dartsim-plugin</filename></engine></plugin>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  <plugin filename="SharedWorldObserver" name="SharedWorldObserver"/>
  <model name="ground"><static>true</static><link name="ground">
   <collision name="surface"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision>
   <visual name="surface"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></visual>
  </link></model>
  <model name="west_store"><static>true</static><pose>-11 8 2.5 0 0 0</pose><link name="body">
   <collision name="shell"><geometry><box><size>4 10 5</size></box></geometry></collision>
   <visual name="shell"><geometry><box><size>4 10 5</size></box></geometry></visual>
  </link></model>
  <model name="east_store"><static>true</static><pose>11 8 3 0 0 0</pose><link name="body">
   <collision name="shell"><geometry><box><size>4 10 6</size></box></geometry></collision>
   <visual name="shell"><geometry><box><size>4 10 6</size></box></geometry></visual>
  </link></model>
  <model name="north_store"><static>true</static><pose>0 18 2 0 0 0</pose><link name="body">
   <collision name="shell"><geometry><box><size>10 4 4</size></box></geometry></collision>
   <visual name="shell"><geometry><box><size>10 4 4</size></box></geometry></visual>
  </link></model>
  <include><uri>model://argos_iris_A1</uri><name>A1</name><pose degrees="true">-6 0 0.195 0 0 90</pose></include>
  <include><uri>model://argos_iris_A2</uri><name>A2</name><pose degrees="true">0 0 0.195 0 0 90</pose></include>
  <include><uri>model://argos_iris_A3</uri><name>A3</name><pose degrees="true">6 0 0.195 0 0 90</pose></include>
 </world>
</sdf>
