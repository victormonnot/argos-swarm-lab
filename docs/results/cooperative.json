      ],
      "standardDeviationMetresPerAxis": 0.15,
      "covariance": "0.0225 I2",
      "interpretation": "A direct relative Cartesian displacement p2-p1, including orientation in the already shared world axes. No range-to-Cartesian conversion, heading estimation, bearing, data association or synthetic radio geometry is modeled."
    },
    "absoluteObservation": {
      "H": [
        [
          1,
          0,
          0,
          0
        ],
        [
          0,
